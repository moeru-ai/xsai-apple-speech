{
  "name": "xsai-apple-speech-workspace",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:native": "pnpm --filter @xsai-apple-speech/transcription-native build:native",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && pnpm --filter @xsai-apple-speech/vitest-plugin-fakemic test",
    "test:unit": "vitest run --project unit",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
